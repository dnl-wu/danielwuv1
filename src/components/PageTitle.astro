---
// Page header: a sentence-case serif title with an optional one-line personal intro under it.
interface Props {
  title: string;
  intro?: string;
}
const { title, intro } = Astro.props;
---

<header>
  <h1 class="font-serif text-[1.9rem] leading-tight font-bold text-ink">{title}</h1>
  {intro && <p class="mt-3 text-ink-soft">{intro}</p>}
</header>
