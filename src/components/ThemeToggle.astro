---
// Y2K four-point sparkle with concave sides.
const star = 'M12 1.5Q13.4 10.6 22.5 12Q13.4 13.4 12 22.5Q10.6 13.4 1.5 12Q10.6 10.6 12 1.5Z';
---

<button
  type="button"
  id="theme-toggle"
  class="group -m-2 rounded-full p-2 text-ink"
  aria-label="Toggle dark mode"
>
  <!-- Half filled: one side for light, one for dark. Spins on hover. -->
  <svg class="size-6 transition-transform duration-500 ease-out group-hover:rotate-180" viewBox="0 0 24 24" aria-hidden="true">
    <defs>
      <clipPath id="star-half"><rect x="12" y="0" width="12" height="24" /></clipPath>
    </defs>
    <path d={star} clip-path="url(#star-half)" fill="currentColor" />
    <path d={star} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
  </svg>
</button>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>
