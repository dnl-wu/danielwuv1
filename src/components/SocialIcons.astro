---
// Outline icons for your social links and email (24px grid, 1.75 stroke).
import { site, socials } from '../data/site';

const links = [...socials, { label: 'Email', icon: 'mail', href: `mailto:${site.email}` }] as const;
---

<ul class="flex items-center gap-1">
  {
    links.map(({ label, icon, href }) => (
      <li>
        <a
          href={href}
          rel={href.startsWith('mailto:') ? undefined : 'me noopener'}
          aria-label={label}
          title={label}
          class="icon-link flex size-8 items-center justify-center rounded-md text-muted transition-colors duration-200 ease-out hover:bg-highlight hover:text-black"
        >
          <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {icon === 'linkedin' && (
              <>
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" />
                <rect x="2" y="9" width="4" height="12" />
                <circle cx="4" cy="4" r="2" />
              </>
            )}
            {icon === 'x' && (
              <>
                <path d="M4 4l11.733 16h4.267l-11.733-16z" />
                <path d="M4 20l6.768-6.768m2.46-2.46L20 4" />
              </>
            )}
            {icon === 'github' && (
              <>
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </>
            )}
            {icon === 'mail' && (
              <>
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </>
            )}
          </svg>
        </a>
      </li>
    ))
  }
</ul>
