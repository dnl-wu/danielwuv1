---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, formatDate, readingTime, type Post } from '../../lib/content';
import { site } from '../../data/site';

export async function getStaticPaths() {
  // Articles that point at a project case study don't get their own page.
  const posts = (await getPosts()).filter((post) => !post.data.project);
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // Posts are newest-first, so the next-newer post is at i - 1.
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props as { post: Post; newer?: Post; older?: Post };
const { title, summary, date, draft } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title} description={summary} type="article">
  <article>
    <a href="/writing" class="hl -my-1.5 inline-block rounded-sm py-1.5 text-sm text-muted">← Writing</a>
    <h1 class="display mt-6 text-[2.4rem] leading-[1.05] text-balance">{title}</h1>
    <p class="mt-3 text-lg leading-snug text-muted">{summary}</p>
    <div class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-y border-rule py-3 text-sm">
      <span class="font-medium text-ink">{site.name}</span>
      <span class="text-muted">
        {date && <><time datetime={date.toISOString()}>{formatDate(date)}</time> · </>}{readingTime(post.body)}{draft && ' · Draft'}
      </span>
    </div>
    <div class="prose prose-site mt-8 max-w-none">
      <Content />
    </div>
  </article>

  {
    (newer || older) && (
      <nav aria-label="More writing" class="mt-14 flex flex-col gap-2 text-sm">
        {older && (
          <p>
            <span class="text-muted">Older: </span>
            <a class="link" href={`/writing/${older.id}`}>{older.data.title}</a>
          </p>
        )}
        {newer && (
          <p>
            <span class="text-muted">Newer: </span>
            <a class="link" href={`/writing/${newer.id}`}>{newer.data.title}</a>
          </p>
        )}
      </nav>
    )
  }
</BaseLayout>
